# Copy to .env and adjust. Defaults below match docker-compose service names.

ENVIRONMENT=development
LOG_LEVEL=INFO

# gRPC
GRPC_HOST=0.0.0.0
GRPC_PORT=50051

# REST API
API_HOST=0.0.0.0
API_PORT=8000
JWT_SECRET=change-me-in-prod

# Postgres (host names = docker-compose services)
DATABASE_URL=postgresql+asyncpg://synapse:synapse@postgres:5432/synapse
DATABASE_URL_SYNC=postgresql+psycopg://synapse:synapse@postgres:5432/synapse

# Redis
REDIS_URL=redis://redis:6379/0

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=synapse_functions
EMBEDDING_DIM=384

# MinIO / S3
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=synapse-mcp-servers

# ── LLM ──────────────────────────────────────────────────────────────────────
# Start with the mock provider (no key needed). To use a real model, set
# LLM_PROVIDER=anthropic and ANTHROPIC_API_KEY=... (or openai + OPENAI_API_KEY).
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_MODEL=gpt-4o

# Quota per API key
DEFAULT_MAX_MCP_SERVERS=25
DEFAULT_MAX_LINES_INDEXED=1000000
